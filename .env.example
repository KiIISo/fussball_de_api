# API Key for securing the endpoint
API_KEY="your-secret-api-key"

# Cache Time-To-Live (TTL) in seconds
CACHE_TTL_GAMES=900       # TTL for club/team game lists
CACHE_TTL_TABLE=3600      # TTL for team league tables
CACHE_TTL_TEAMS=7200      # TTL for club team lists
CACHE_TTL_FONT=86400      # TTL for score deobfuscation font maps

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# Proactive Caching (Pre-warming)
# Set the club ID to enable pre-warming for a specific club
PREWARM_CLUB_ID="001VTR8D8C000000VARTQG41VT4929AS"
PREWARM_INTERVAL_SECONDS=300
# Schedules (/api/team/{team_id}/schedule) of teams requested within this many days
# are refreshed by the pre-warm loop, independent of PREWARM_CLUB_ID
PREWARM_RECENT_DAYS=14

# Minimum gap in seconds between two live requests to fussball.de (across all threads)
FETCH_MIN_INTERVAL_SECONDS=0.5

# Cache directory (inside container or on host)
# Default: ./cache
# Example for Docker: /app/cache
CACHE_DIR="./cache"

# Logo Proxy
# Directory where downloaded club logos are stored
LOGOS_DIR="/app/logos"
# Base URL prepended to logo paths in API responses (e.g. https://your-domain.de)
# Leave empty for relative paths (/logos/<hash>.png)
LOGO_BASE_URL="https://your-domain.de"
